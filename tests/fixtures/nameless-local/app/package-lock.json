{
  "name": "coordinator",
  "lockfileVersion": 3,
  "packages": {
    "": {
      "name": "coordinator",
      "workspaces": [
        "packages/@example/*"
      ],
      "dependencies": {
        "@example/shared": "file:../@example/shared"
      }
    },
    "packages/@example/worker": {
      "version": "1.2.3"
    },
    "../@example/shared": {
      "version": "4.5.6"
    },
    "node_modules/@example/worker": {
      "resolved": "packages/@example/worker",
      "link": true
    },
    "node_modules/@example/shared": {
      "resolved": "../@example/shared",
      "link": true
    }
  }
}
